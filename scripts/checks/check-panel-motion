#!/usr/bin/env python3
"""Opt-in GUI frame-interval probe while exercising the real desktop panels."""
import argparse
import json
from pathlib import Path
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--live', action='store_true')
args = parser.parse_args()
if not args.live:
    parser.error('This opens desktop panels; opt in with --live')
root = Path(__file__).resolve().parents[2]
base = ['quickshell', 'ipc', '--path', str(root / 'shell'), 'call', 'shell']

def call(method, *arguments):
    return subprocess.check_output(base + [method, *arguments], text=True, timeout=4)

# Do not accidentally measure startup/cache building or a QML hot reload.
for _ in range(30):
    try:
        status = json.loads(call('launcherStatus'))
        if status.get('cachedIcons', 0):
            break
    except (ValueError, subprocess.SubprocessError):
        pass
    time.sleep(.1)

try:
    call('closeBarPanel')
    call('closeQuickSettings')
    time.sleep(.4)
    for page in ['launcher', 'calendar', 'notifications', 'quick-settings']:
        call('startFrameProbe')
        for _ in range(3):
            if page == 'quick-settings':
                call('toggleQuickSettings')
            else:
                call('toggleBarPanel', page)
            time.sleep(.70 if page == 'launcher' else .45)
            call('closeQuickSettings' if page == 'quick-settings' else 'closeBarPanel')
            time.sleep(.30 if page == 'launcher' else .22)
        result = json.loads(call('stopFrameProbe'))
        if result['samples'] < 30:
            raise RuntimeError('Probe was interrupted or reloaded; discard this capture')
        print(page, json.dumps(result), flush=True)
finally:
    call('stopFrameProbe')
    call('closeBarPanel')
    call('closeQuickSettings')
