#!/usr/bin/env python3
"""Opt-in native mouse regression checks for companion picking and throwing."""
import argparse
import json
from pathlib import Path
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--live', action='store_true')
if not parser.parse_args().live:
    parser.error('Moves the real pointer and opens the calendar; explicitly pass --live')
root = Path(__file__).resolve().parents[2]
base = ['quickshell', 'ipc', '--path', str(root / 'shell'), 'call']


def ipc(*args):
    for _ in range(40):
        value = subprocess.check_output(base + list(args), text=True).strip()
        if not value.startswith('Not ready'):
            return json.loads(value) if value.startswith('{') else value
        time.sleep(.05)
    raise RuntimeError('Shell not ready')


def hypr(name):
    return json.loads(subprocess.check_output(['hyprctl', '-j', name], text=True))


screen = next(m['name'] for m in hypr('monitors') if m['focused'])
endpoint = 'companion-' + screen
original = ipc('companion', 'status')
cursor = hypr('cursorpos')
button_down = False


def status():
    return ipc(endpoint, 'status')


def wait(predicate, description, seconds=5):
    end = time.monotonic() + seconds
    while time.monotonic() < end:
        s = status()
        if predicate(s):
            return s
        time.sleep(.02)
    raise AssertionError(description + ': ' + json.dumps(status()))


def move(x, y):
    # The existing virtual relative pointer has approximately 2x absolute scale.
    subprocess.run(['ydotool', 'mousemove', '--absolute', str(round(x / 2)), str(round(y / 2))], check=True)


def relative(x, y):
    subprocess.run(['ydotool', 'mousemove', '--', str(x), str(y)], check=True)


def button(down):
    global button_down
    subprocess.run(['ydotool', 'click', '-D', '0', '0x40' if down else '0x80'], check=True, stdout=subprocess.DEVNULL)
    button_down = down


def aim(x=.5, y=.55):
    s = status()
    b = s['bounds']
    extent = b['width'] - 24
    move(b['x'] + 12 + x * extent, b['y'] + 4 + y * extent)
    return wait(lambda s: s['held'], 'Hover must pause movement', 1)


def home():
    ipc('companion', 'flights', 'false')
    return wait(lambda s: s['visible'] and s['travel']['mode'] == 'rail' and s['throwState']['mode'] == 'idle', 'Return home', 20)


def release_and_recover():
    button(False)
    wait(lambda s: not s['pressing'] and not s['dragging'], 'Release must clear grab')
    return wait(lambda s: s['throwState']['mode'] == 'idle', 'Throw must finish', 10)


try:
    if not status()['visible']:
        raise RuntimeError('Companion must be visible; close fullscreen/overview/panels before checking')
    home()
    for name, x, y in [('head', .5, .2), ('left hand', .16, .7), ('feet', .55, .97), ('right hand', .86, .7), ('head edge', .25, .1), ('chest', .5, .58)]:
        aim(x, y)
        button(True)
        s = wait(lambda s: s['pressing'], 'Capture ' + name, .14)
        assert s['activity'] == 'grabbed' and not s['dragging'], s
        button(False)
        wait(lambda s: not s['pressing'], 'Clear press', .14)
        assert status()['throwState']['mode'] == 'idle', status()
        print('PASS capture and ordinary click: ' + name, flush=True)

    # In particular, a tap must not launch while flight preferences are enabled.
    aim()
    ipc('companion', 'flights', 'true')
    button(True)
    wait(lambda s: s['pressing'], 'Click press', .14)
    relative(1, 0)
    button(False)
    s = wait(lambda s: not s['pressing'], 'Click release', .14)
    assert s['travel']['mode'] == 'rail' and s['throwState']['mode'] == 'idle', s
    time.sleep(.25)
    assert status()['travel']['mode'] == 'rail'
    print('PASS small click jitter does not throw or launch', flush=True)

    move(950, 600)
    ipc(endpoint, 'takeOff')
    wait(lambda s: s['travel']['mode'] == 'fly', 'Enter flight', 5)
    aim()
    s = status()
    time.sleep(.3)
    later = status()
    assert later['travel']['age'] == s['travel']['age'] and later['bounds'] == s['bounds'], (s, later)
    print('PASS hovering a flying robot freezes its location', flush=True)

    button(True)
    wait(lambda s: s['pressing'], 'Air capture', .14)
    for dx, dy in [(8, 6), (8, 6), (-6, 10), (12, -6)]:
        relative(dx, dy)
        s = wait(lambda s: s['dragging'], 'Start drag')
        p = hypr('cursorpos')
        assert abs(s['bounds']['x'] - (p['x'] - s['grip']['x'])) <= 3 and abs(s['bounds']['y'] - (p['y'] - s['grip']['y'])) <= 3, (s, p)
        assert s['surface']['width'] == s['bounds']['width'], s
        time.sleep(.06)
        # Check the committed compositor window, not only the QML model.
        s = status()
        visual = next(item for level in hypr('layers')[screen]['levels'].values() for item in level if item['namespace'] == 'poly-companion')
        assert abs(visual['x'] - s['bounds']['x']) <= 1 and abs(visual['y'] - s['bounds']['y']) <= 1, (visual, s)

    print('PASS air capture and zigzag drag track actual pointer', flush=True)
    # Rescue is tested away from support edges; dropping over an edge now lands.
    s = status()
    relative(round(900 - s['bounds']['x']), round(500 - s['bounds']['y']))
    time.sleep(.25)
    button(False)
    wait(lambda s: s['throwState']['mode'] == 'brake', 'Begin rescue')
    s = status()
    b = s['bounds']
    move(b['x'] + 35, b['y'] + 28)
    button(True)
    s = wait(lambda s: s['pressing'], 'Re-capture during rescue', .14)
    b = s['bounds']
    time.sleep(.15)
    assert status()['bounds'] == b, status()
    relative(8, 6)
    wait(lambda s: s['dragging'], 'Re-drag after rescue capture')
    time.sleep(.2)
    release_and_recover()
    print('PASS re-capture during rescue freezes position and permits another drag', flush=True)

    home()
    aim()
    button(True)
    wait(lambda s: s['pressing'], 'Stationary hold', .14)
    time.sleep(.25)
    b = status()['bounds']
    time.sleep(.15)
    assert status()['bounds'] == b
    release_and_recover()
    print('PASS stationary hold stays fixed and drops gently', flush=True)

    home()
    aim()
    button(True)
    wait(lambda s: s['pressing'], 'Cancel press', .14)
    relative(8, 6)
    wait(lambda s: s['dragging'], 'Cancel dragging')
    ipc('companion', 'enable', 'false')
    wait(lambda s: not s['visible'] and not s['pressing'] and not s['dragging'], 'Disable cancels press')
    button(False)
    ipc('companion', 'enable', 'true')
    wait(lambda s: s['visible'] and not s['pressing'], 'Enable restores')
    wait(lambda s: s['throwState']['mode'] == 'idle', 'Cancel recovery')
    print('PASS disabling during a drag cancels cleanly', flush=True)

    # Input away from the companion must still reach ordinary bar controls.
    controls = ipc('bar-' + screen, 'controls')['calendar']
    move(controls['x'] + controls['width'] / 2, controls['y'] + controls['height'] / 2)
    time.sleep(.1)
    button(True)
    button(False)
    time.sleep(.2)
    assert ipc('shell', 'status')['bar']['popup'] == 'calendar'
    ipc('shell', 'closeBarPanel')
    print('PASS bar input outside companion still works', flush=True)
finally:
    if button_down:
        button(False)
    ipc('shell', 'closeBarPanel')
    ipc('companion', 'enable', str(original['enabled']).lower())
    ipc('companion', 'flights', str(original['flights']).lower())
    move(cursor['x'], cursor['y'])
