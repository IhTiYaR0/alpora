#!/usr/bin/env python3
"""Opt-in live test: shortcut and immediate text, without executing applications."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--live', action='store_true', help='open a temporary Kitty input sink and exercise Super+R')
args = parser.parse_args()
if not args.live:
    parser.error('This uses the running desktop; opt in with --live')

root = Path(__file__).resolve().parents[2]
base = ['quickshell', 'ipc', '--path', str(root / 'shell'), 'call']
environment = dict(os.environ, YDOTOOL_SOCKET=os.environ.get('YDOTOOL_SOCKET', f'/run/user/{os.getuid()}/.ydotool_socket'))

def ipc(target, method):
    return subprocess.check_output(base + [target, method], text=True, timeout=4)

keyboards = json.loads(subprocess.check_output(['hyprctl', 'devices', '-j'], text=True))['keyboards']
keyboard = next(k for k in keyboards if k['name'] == 'ydotoold-virtual-device')
if keyboard['layout'] != 'us,ru':
    raise SystemExit('This test expects the existing US/RU virtual-keyboard layout')
monitors = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], text=True))
screen = next(m['name'] for m in monitors if m['focused'])
target = 'launcher-' + screen
original = keyboard['active_layout_index']
sink = subprocess.Popen(['kitty', '--class', 'poly-input-test', '--title', 'Poly Shell input test', 'cat'],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
failures = []
try:
    time.sleep(.5)
    for layout, expected in [(0, 'firefox'), (1, 'ашкуащч')]:
        subprocess.run(['hyprctl', 'switchxkblayout', keyboard['name'], str(layout)], check=True, stdout=subprocess.DEVNULL)
        for delay in [2, 5, 10, 5, 5, 10]:
            ipc('shell', 'closeBarPanel')
            time.sleep(.35)
            # One uninterrupted event sequence, with no sleep between the
            # shortcut and typing. Text is never submitted using Enter.
            keys = ['125:1', '19:1', '19:0', '125:0']
            keys += [event for code in [33, 23, 19, 18, 33, 24, 45]
                     for event in [f'{code}:1', f'{code}:0']]
            subprocess.run(['ydotool', 'key', '--key-delay', str(delay)] + keys,
                           env=environment, check=True, stdout=subprocess.DEVNULL)
            time.sleep(.08)
            result = json.loads(ipc(target, 'inputStatus'))
            passed = result['opened'] and result['focused'] and result['text'] == expected
            print(('PASS' if passed else 'FAIL'), 'US' if layout == 0 else 'RU', f'{delay}ms', result['text'], flush=True)
            if not passed:
                failures.append(result)
                print("Input diagnostic:",json.dumps(result,ensure_ascii=False),flush=True)
    ipc('shell', 'closeBarPanel')
    time.sleep(.04)
    ipc('shell', 'toggleLauncher')
    time.sleep(.08)
    assert json.loads(ipc(target, 'inputStatus'))['text'] == '', 'Rapid reopen kept stale text'
finally:
    ipc('shell', 'closeBarPanel')
    subprocess.run(['hyprctl', 'switchxkblayout', keyboard['name'], str(original)], stdout=subprocess.DEVNULL)
    sink.terminate()
    try:
        sink.wait(timeout=4)
    except subprocess.TimeoutExpired:
        sink.kill()
        sink.wait()
if failures:
    raise SystemExit(f'{len(failures)} immediate-input attempts failed')
print('12/12 immediate-input attempts and rapid reopen passed; virtual layout restored.')
