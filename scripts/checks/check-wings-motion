#!/usr/bin/env python3
"""Measure passive window swaps during the selected Wings reveal, without frame polling."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import time

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--live', action='store_true')
parser.add_argument('--diagnose', action='store_true')
parser.add_argument('--snapshot', action='store_true')
parser.add_argument('--interactions', action='store_true')
parser.add_argument('--page', choices=['launcher','calendar','notifications','quick-settings'])
parser.add_argument('--trials', type=int, default=3)
args = parser.parse_args()
if args.diagnose:
    print('\n'.join(subprocess.check_output(['ps', '-eo', 'pid,pcpu,pmem,comm', '--sort=-pcpu'],text=True).splitlines()[:16]))
    for proc in Path('/proc').glob('[0-9]*'):
        try:
            if proc.joinpath('comm').read_text().strip() in ('quickshell', 'qs'):
                selected=[v.decode(errors='replace') for v in proc.joinpath('environ').read_bytes().split(b'\0') if v.startswith((b'QSG_', b'QSGINFO', b'QT_QUICK', b'QT_QPA', b'LIBGL_', b'QRHI_'))]
                print('RENDER ENV', proc.name, selected)
        except (OSError, PermissionError):
            pass
    log=subprocess.check_output(['journalctl','--user','-u','poly-shell.service','-n','700','--no-pager'],text=True)
    print('\n'.join(line for line in log.splitlines() if any(w in line.lower() for w in ['shader','error','warn','render loop']))[-11000:])
    raise SystemExit(0)
if not args.live:

    parser.error('This opens desktop panels; opt in with --live')
root = Path(__file__).resolve().parents[2]
base = ['quickshell', 'ipc', '--path', str(root / 'shell'), 'call']

def call(target, method, *args):
    return subprocess.check_output(base + [target, method, *args], text=True, timeout=5)

screens = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], text=True))
screen = next(s['name'] for s in screens if s['focused'])
if args.interactions:
    focused = next(s for s in screens if s['focused'])
    if focused['width'] != 1920 or focused['scale'] != 1:
        raise SystemExit('Pointer check is scoped to the verified 1920px, scale-1 desktop')
    cursor = json.loads(subprocess.check_output(['hyprctl', 'cursorpos', '-j'], text=True))
    env = dict(os.environ, YDOTOOL_SOCKET=os.environ.get('YDOTOOL_SOCKET', '/run/user/' + str(os.getuid()) + '/.ydotool_socket'))
    def pointer(x, y, click=False):
        subprocess.run(['ydotool','mousemove','--absolute',str(round(x / 2)),str(round(y / 2))],env=env,check=True,stdout=subprocess.DEVNULL)
        if click:
            time.sleep(.08)
            actual=json.loads(subprocess.check_output(['hyprctl','cursorpos','-j'],text=True))
            assert abs(actual['x']-x)<=2 and abs(actual['y']-y)<=2, (x,y,actual)
            subprocess.run(['ydotool','click','0xC0'],env=env,check=True,stdout=subprocess.DEVNULL)
    try:
        call('shell', 'closeBarPanel');call('shell','closeQuickSettings');time.sleep(.3)
        bounds=json.loads(call('bar-'+screen,'controls'))
        for key, page in [('launcher','launcher'),('calendar','calendar'),('quickSettings','quick-settings')]:
            rect=bounds[key];x=round(rect['x']+rect['width']/2);y=round(rect['y']+rect['height']/2)
            pointer(x,y,True);time.sleep(.75)
            state=json.loads(call('shell','status'))
            assert (state['quickSettings'] if page=='quick-settings' else state['bar']['popup']==page), (page,rect,state['bar'],state['quickSettings'],json.loads(call('bar-'+screen,'controls')))
            print('PASS bar click →',page,flush=True)
        rect=bounds['quickSettings'];pointer(round(rect['x']+rect['width']/2),round(rect['y']+rect['height']/2),True);time.sleep(.3)
        assert not json.loads(call('shell','status'))['quickSettings']
    finally:
        call('shell','closeBarPanel');call('shell','closeQuickSettings')
        pointer(cursor['x'],cursor['y'])
    time.sleep(.5)
    for proc in Path('/proc').glob('[0-9]*'):
        try:
            if proc.joinpath('comm').read_text().strip() != 'quickshell':continue
            def ticks():
                fields=proc.joinpath('stat').read_text().split();return int(fields[13])+int(fields[14])
            before=ticks();start=time.monotonic();time.sleep(1.5)
            print('Idle sample: %.2f%% of one CPU core' % ((ticks()-before)/os.sysconf('SC_CLK_TCK')/(time.monotonic()-start)*100),flush=True)
        except OSError:pass
    raise SystemExit(0)
records = {}
try:
    call('shell', 'closeBarPanel'); call('shell', 'closeQuickSettings'); time.sleep(.5)
    for page, target in [('launcher', 'launcher-'), ('calendar', 'bar-popup-'), ('notifications', 'bar-popup-'), ('quick-settings', 'quick-settings-')]:
        if args.page and page != args.page: continue
        target += screen
        def toggle():
            return call('shell', 'toggleQuickSettings') if page == 'quick-settings' else call('shell', 'toggleBarPanel', page)
        close = 'closeQuickSettings' if page == 'quick-settings' else 'closeBarPanel'
        captures = []
        for trial in range(args.trials):
            call(target, 'startMotionTrace')
            toggle()
            if args.snapshot and trial == 0:
                time.sleep(.28)
                subprocess.run(['grim','/tmp/poly-wings-'+page+'-half.png'],check=True,stdout=subprocess.DEVNULL)
            time.sleep(.68)
            if args.snapshot and trial == 0:
                subprocess.run(['grim','/tmp/poly-wings-'+page+'-open.png'],check=True,stdout=subprocess.DEVNULL)
            status = json.loads(call(target, 'motionStatus'))
            frames = json.loads(call(target, 'stopMotionTrace'))
            assert status['progress'] == 1 and status['effectReady'], (page, status)
            assert abs(status['width'] - status['fullWidth']) < .01
            assert abs(status['height'] - status['fullHeight']) < .01
            moving = [f for f in frames if 0 < f['progress'] < 1]
            intervals = sorted(b['ms'] - a['ms'] for a, b in zip(moving, moving[1:]))
            captures.append({'frames': len(moving), 'p95Ms': intervals[int((len(intervals)-1)*.95)] if intervals else None, 'maxMs': max(intervals, default=0), 'trace': moving})
            call('shell', close); time.sleep(.32)
            assert json.loads(call(target, 'motionStatus'))['progress'] == 0
        records[page] = captures
        print(page, json.dumps([{k:v for k,v in c.items() if k!='trace'} for c in captures]), flush=True)
    # Alternating a shared popup must retain its old layout until fully closed.
    call('shell', 'toggleBarPanel', 'calendar'); time.sleep(.12)
    call('shell', 'toggleBarPanel', 'notifications'); time.sleep(.8)
    switched = json.loads(call('bar-popup-' + screen, 'motionStatus'))
    assert switched['page'] == 'notifications' and switched['progress'] == 1, switched
    call('shell', 'closeBarPanel'); time.sleep(.3)
    for _ in range(4):
        call('shell', 'toggleLauncher'); time.sleep(.035)
        call('shell', 'closeBarPanel'); time.sleep(.025)
    call('shell', 'toggleLauncher'); time.sleep(.7)
    assert json.loads(call('launcher-' + screen, 'motionStatus'))['progress'] == 1
    print('PASS endpoints, popup switching, rapid reversals', flush=True)
finally:
    call('shell', 'closeBarPanel');call('shell', 'closeQuickSettings')
    Path('/tmp/poly-wings-timing.json').write_text(json.dumps(records, indent=2))

# Regression guard: closing a calendar/control panel must remove its full-screen
# Wayland surface, rather than retaining a transparent compositor blur target.
time.sleep(.3)
layers=json.loads(subprocess.check_output(['hyprctl','layers','-j'],text=True))
retained=[item for monitor in layers.values() for level in monitor['levels'].values()
          for item in level if item.get('namespace') in ('poly-shell-bar-popup','poly-shell-quick-settings')]
assert not retained, ('Closed full-screen popup surfaces remain mapped',retained)
print('PASS closed calendar/control surfaces are unmapped',flush=True)
