#!/usr/bin/env python3
"""Opt-in backend keybinding transaction check using a temporary harmless key.

Registers one command, triggers it, edits/disables/removes it and restores the
original effective bindings. Does not open windows or operate application UI.
"""
import argparse
parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--live',action='store_true')
if not parser.parse_args().live:parser.error('Changes real bindings briefly; pass --live')
import json,os,subprocess,shlex,tempfile,time
from pathlib import Path
base=[str(Path(__file__).resolve().parents[2]/'bin/poly-shell'),'shortcuts']
def call(action,payload=None):
 r=subprocess.run(base+[action]+([json.dumps(payload)] if payload else []),capture_output=True,text=True,timeout=15)
 if r.returncode:raise RuntimeError(r.stderr)
 return json.loads(r.stdout)
def active():return json.loads(subprocess.check_output(['hyprctl','-j','binds'],text=True))
session=os.environ.get('XDG_SESSION_ID','')
if session and subprocess.check_output(['loginctl','show-session',session,'-p','Active','--value'],text=True).strip()!='yes':
 raise RuntimeError('The graphical session must be active for a real key check')
temporary=tempfile.TemporaryDirectory(prefix='poly-shortcut-key-')
marker=Path(temporary.name)/'activated'
original=call('get')['values'];current=original
custom=dict(id='custom-backend-regression',source='',key='SUPER + SHIFT + F8',title='Poly backend regression',action='command',argument=shlex.join(['touch',str(marker)]),enabled=True,locked=False,repeat=False)
assert not any(b.get('key') in ('F8','F9') and b.get('modmask')==65 for b in active()),'Probe keys already in use'
try:
 for label,values in [('add',original+[custom]),('edit',original+[dict(custom,key='SUPER + SHIFT + F9')]),('disable',original+[dict(custom,key='SUPER + SHIFT + F9',enabled=False)]),('remove',original)]:
  result=call('apply',dict(values=values,expected=current));current=result['values']
  assert call('get')['values']==current
  print('PASS native registration and persistence:',label,flush=True)
  if label=='add':
   time.sleep(.25)
   subprocess.run(['ydotool','key','--key-delay','40','42:1','125:1','66:1','66:0','125:0','42:0'],check=True,stdout=subprocess.DEVNULL)
   deadline=time.monotonic()+3
   while not marker.exists() and time.monotonic()<deadline:time.sleep(.03)
   assert marker.exists(),'Registered shortcut did not execute command'
   print('PASS real key chord executes configured command',flush=True)
 assert not any(b.get('description')=='Poly: Poly backend regression' for b in active())
 assert not [e for e in json.loads(subprocess.check_output(['hyprctl','-j','configerrors'],text=True)) if e.strip()]
finally:
 try:
  subprocess.run(['ydotool','key','66:0','125:0','42:0'],check=False,stdout=subprocess.DEVNULL)
 finally:
  try:
   if current!=original:call('apply',dict(values=original,expected=current))
  finally:temporary.cleanup()
